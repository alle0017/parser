axiom EXPRESSION_LIST

skip '[ \t\n\r]+'


token NUM        '[0-9]+(\.[0-9]+)?'
token STRING     '"[^"]*"'


token FN         'fn'
token STRUCT     'struct'
token CONST      'const'
token RETURN     'return'

token IF         'if'
token ELSE       'else'
token WHILE      'while'

token AND        '&&'
token OR         '||'
token NOT        '!'

token GT         '>'
token LT         '<'
token GE         '>='
token LE         '<='
token EQ         '=='

token PLUS       '\+'
token MINUS      '-'
token MUL        '\*'
token DIV        '\/'
token MOD        '%'

token ASSIGN     '='
token ID         '[a-zA-Z][a-zA-Z0-9_]*'

token LEFT_BRACKET    '{'
token RIGHT_BRACKET   '}'
token LEFT_PAR        '\('
token RIGHT_PAR       '\)'
token LEFT_SQUARE     '\['
token RIGHT_SQUARE    '\]'

token COLUMN          ':'
token SEMI_COLUMN     ';'
token COMMA           ','
token DOT             '\.'


reduction FIELD          "ID COLUMN ID"
reduction FIELD_LIST     "FIELD | FIELD_LIST COMMA FIELD"

reduction STRUCT_DEF     "STRUCT ID LEFT_BRACKET FIELD_LIST RIGHT_BRACKET"

reduction FUNCTION_DEF   "FN ID LEFT_PAR FIELD_LIST RIGHT_PAR COLUMN ID CODE_BLOCK | FN ID LEFT_PAR RIGHT_PAR COLUMN ID CODE_BLOCK"
reduction CODE_BLOCK "LEFT_BRACKET EXPRESSION_LIST RIGHT_BRACKET"
reduction EXPRESSION "FUNCTION_DEF | STRUCT_DEF"
reduction EXPRESSION_LIST "EXPRESSION_LIST EXPRESSION | EXPRESSION"