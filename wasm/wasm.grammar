axiom EXPRESSION_LIST

skip '[ \t\n\r]+'

token NUM        '[0-9]+(\.[0-9]+)?'
token STRING     '"[^"]*"'

token FN         'fn'
token STRUCT     'struct'
token CONST      'const'
token RETURN     'return'

token IF         'if'
token ELSE       'else'
token WHILE      'while'

token AND        '&&'
token OR         '||'
token NOT        '!'

token GT         '>'
token LT         '<'
token GE         '>='
token LE         '<='
token EQ         '=='

token PLUS       '\+'
token MINUS      '-'
token MUL        '\*'
token DIV        '\/'
token MOD        '%'

token ASSIGN     '='
token ID         '[a-zA-Z][a-zA-Z0-9_]*'

token LEFT_BRACKET    '{'
token RIGHT_BRACKET   '}'
token LEFT_PAR        '\('
token RIGHT_PAR       '\)'
token LEFT_SQUARE     '\['
token RIGHT_SQUARE    '\]'

token COLUMN          ':'
token SEMI_COLUMN     ';'
token COMMA           ','
token DOT             '\.'

reduction FIELD          "ID COLUMN ID"
reduction FIELD_LIST     "FIELD_LIST COMMA FIELD | FIELD"

reduction STRUCT_DEF     "STRUCT ID LEFT_BRACKET FIELD_LIST RIGHT_BRACKET"

reduction FUNCTION_DEF
  "FN ID LEFT_PAR FIELD_LIST RIGHT_PAR COLUMN ID CODE_BLOCK
   | FN ID LEFT_PAR RIGHT_PAR COLUMN ID CODE_BLOCK"

reduction CONST_DECL
  "CONST ID ASSIGN ID SEMI_COLUMN"
reduction RET_EXPR "RETURN ID SEMI_COLUMN"

reduction IF_EXPR
  "IF LEFT_PAR ID RIGHT_PAR LEFT_BRACKET STATEMENT_LIST RIGHT_BRACKET 
  | IF_EXPR ELSE IF_EXPR"

reduction COND_EXPR "IF_EXPR ELSE LEFT_BRACKET STATEMENT_LIST RIGHT_BRACKET"


reduction WHILE_EXPR
  "WHILE LEFT_PAR ID RIGHT_PAR LEFT_BRACKET STATEMENT_LIST RIGHT_BRACKET"

reduction STATEMENT
  "CONST_DECL
   | IF_EXPR
   | COND_EXPR
   | WHILE_EXPR
   | RET_EXPR"

reduction STATEMENT_LIST
  "STATEMENT_LIST STATEMENT | STATEMENT"

reduction CODE_BLOCK
  "LEFT_BRACKET STATEMENT_LIST RIGHT_BRACKET"

reduction EXPRESSION
  "FUNCTION_DEF
   | STRUCT_DEF"

reduction EXPRESSION_LIST
  "EXPRESSION
   | EXPRESSION_LIST EXPRESSION"